        <profile name="The Communicant Cross or Helm" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="d2b6-8e4f-5c01-3003">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">The Communicant Cross or Helm: A Lazarist Communicant counts as having the following pieces of Equipment at no cost in ducats: Iron Capirote; Gas Mask.</characteristic>
          </characteristics>
        </profile>
      </profiles>
