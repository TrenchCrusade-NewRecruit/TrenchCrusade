      <profiles>
        <profile name="Ecclesiastic Prisoner" typeId="b3af-94f9-2e35-d1c5" typeName="Unit" hidden="false" id="c4bc-74f7-e224-4b01"><characteristics><characteristic name="Movement" typeId="b725-e0a4-16ae-8df2">6&quot;/Infantry</characteristic><characteristic name="Ranged" typeId="1a4f-d2cd-c405-6200">-</characteristic><characteristic name="Melee" typeId="12e8-ff8c-c933-9eb5">-1 DICE</characteristic><characteristic name="Armour" typeId="5de9-d70e-9021-6f71">0</characteristic><characteristic name="Base" typeId="73ae-cc17-596e-0481">25mm</characteristic></characteristics><modifiers><modifier type="set" value="-1 DICE" field="1a4f-d2cd-c405-6200"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="1e805232-b08b-4b7f-b617-969e6bb9cf0f" shared="true" includeChildSelections="true"/></conditions></modifier></modifiers></profile>
        <profile name="Feeble Flailing" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="4512-c6c3-bb7a-4b01"><characteristics><characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Feeble Flailing: An Ecclesiastic Prisoner can make a Melee Attack even though it does not have a Melee Weapon. If it does so, add -1 DICE to the Success Roll.</characteristic></characteristics></profile>
        <profile name="Mad Dash" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="4ed5-3209-4bf7-4b01"><characteristics><characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Mad Dash: Add +1 DICE to the Risky Success Roll for an Ecclesiastic Prisoner that is taking a Dash ACTION.</characteristic></characteristics></profile>
      </profiles>
