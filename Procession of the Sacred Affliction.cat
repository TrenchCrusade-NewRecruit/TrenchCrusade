    <selectionEntry type="model" import="true" name="Lazarist Communicant" hidden="true" id="d2b6-8e4f-5c01-2a73">
      <comment>Procession of the Sacred Affliction (replaces the base Communicant when the Procession variant is selected)</comment>
      <profiles>
        <profile name="Bodyguard" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="d2b6-8e4f-5c01-3001">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Bodyguard: If a friendly PILGRIM model within 1&quot; of a Lazarist Communicant is hit by a Ranged Attack or Melee Attack, you can say that the Lazarist Communicant will take the hit. If you do so, make an Injury Roll for the Lazarist Communicant instead of the original target. This ability cannot be used against attacks that have the BLAST Keyword.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lazarist Communicant" typeId="b3af-94f9-2e35-d1c5" typeName="Unit" hidden="false" id="d2b6-8e4f-5c01-3002">
