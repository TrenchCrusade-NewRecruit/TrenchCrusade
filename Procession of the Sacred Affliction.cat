    <entryLink import="true" name="Homunculus" hidden="true" id="3a5b-6147-1f98-1f33" type="selectionEntry" targetId="3eda-5baa-29d3-d617">
      <categoryLinks>
        <categoryLink targetId="bd43-ddb1-262d-4489" id="3445-cc34-ea37-8c52" primary="true" name="Troop"/>
      </categoryLinks>
      <modifiers>
