        <entryLink import="true" name="Grenades" hidden="false" id="c1a5-7d3e-4b90-2202" type="selectionEntryGroup" targetId="70c8-b7ed-f20b-8bd6" sortIndex="5"/>
        <entryLink import="true" name="Armour" hidden="false" id="c1a5-7d3e-4b90-2203" type="selectionEntryGroup" targetId="664d-b970-6eef-b2d5" sortIndex="6"/>
        <entryLink import="true" name="Equipment" hidden="false" id="c1a5-7d3e-4b90-2204" type="selectionEntryGroup" targetId="8a14-be13-d97b-2a39" sortIndex="7"/>
        <entryLink import="true" name="Advancement" hidden="true" id="c1a5-7d3e-4b90-2205" type="selectionEntryGroup" targetId="bc33-e591-8f2e-a847" collapsible="true" sortIndex="1"/>
        <entryLink import="true" name="Exploration Upgrades" hidden="false" id="c1a5-7d3e-4b90-2206" type="selectionEntryGroup" targetId="6aaa-88b6-f64b-4776"/>
        <entryLink import="true" name="Fireteams" hidden="false" id="c1a5-7d3e-4b90-2207" type="selectionEntryGroup" targetId="e18c-f0d9-1ca3-f7bb" sortIndex="2"/>
      </entryLinks>
      <costs>
        <cost name="Ducats" typeId="8d43-33fd-332d-17a6" value="50"/>
        <cost name="Glory Points" typeId="f3bb-a7e6-d476-f60b" value="0"/>
      </costs>
      <modifiers>
        <modifier type="set" value="3" field="c1a5-7d3e-4b90-2004"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="1e805232-b08b-4b7f-b617-969e6bb9cf0f" shared="true" includeChildSelections="true"/></conditions></modifier>
        <modifier type="set" value="3" field="c1a5-7d3e-4b90-2004"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="a1e1-b2e2-c3e3-d4e4" shared="true" includeChildSelections="true"/></conditions></modifier>
        <modifier type="set" value="Leper-Knight" field="name"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="a1e1-b2e2-c3e3-d4e4" shared="true" includeChildSelections="true"/></conditions></modifier>
        <modifier type="set" value="1" field="27a41677-613b-4547-8874-f32c9270169d"><conditionGroups><conditionGroup type="and"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="1e805232-b08b-4b7f-b617-969e6bb9cf0f" shared="true" includeChildSelections="true"/><condition type="atMost" value="0" field="selections" scope="roster" childId="d2b6-8e4f-5c01-2a73" shared="true" includeChildSelections="true"/></conditions></conditionGroup></conditionGroups></modifier>
        <modifier type="increment" value="1" field="27a41677-613b-4547-8874-f32c9270169d"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="1e805232-b08b-4b7f-b617-969e6bb9cf0f" shared="true" includeChildSelections="true"/></conditions><repeats><repeat value="2" repeats="1" field="selections" scope="roster" childId="d2b6-8e4f-5c01-2a73" shared="true" roundUp="true" includeChildSelections="true"/></repeats></modifier>
