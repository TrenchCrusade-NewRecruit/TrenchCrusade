<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue library="false" id="c421-32f4-581e-9fb6" name="Procession of the Sacred Affliction" gameSystemId="sys-4f3d-c5c9-7df1-ad01" gameSystemRevision="8" revision="8" battleScribeVersion="2.03" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <selectionEntries>
    <selectionEntry type="upgrade" import="true" name="Procession of the Sacred Affliction Rules" hidden="false" id="0d88-774c-22af-e2fc">
      <profiles>
        <profile name="Punishing Millstones" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="4165-7995-659c-116e">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Add +1 INJURY DICE for Melee Attacks made by models from a Procession of the Sacred Affliction if the target is Down. This bonus is in addition to the +1 INJURY DICE modifier that normally applies when a target is Down, giving a total of +2 INJURY DICE to the roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Wrath of God" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="6504-7f68-1688-0f4d">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Up to 1 Lazarist Castigator, Leper-Pilgrim, or Martyr Penitent can have the Wrath of God special rule at a cost of 15 ducats. BLOOD MARKERS are never placed next to a model with the Wrath of God special rule, and it has the NEGATE FEAR Keyword. It cannot be Broken on the Wheel by an Anchorite Shrine. A model with the Wrath of God special rule cannot have Ranged Weapons or Armour (it can have a Shield). In addition, change the base size of the model to 32mm.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mercenaries" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="568c-6690-5a64-9a48">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">The Procession of the Sacred Affliction can use any Faithful Mercenaries that can be taken by PILGRIM Warbands.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint type="min" value="1" field="selections" scope="roster" shared="true" id="2458-1f70-9f50-c02e" includeChildSelections="true" includeChildForces="true"/>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="be7d-f111-c8e1-5395" includeChildSelections="true" includeChildForces="true"/>
      </constraints>
      <categoryLinks>
        <categoryLink targetId="705b-e23f-e9c2-58ab" id="146b-752c-f9a7-9398" primary="true" name="Configuration"/>
      </categoryLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Warband Variant" hidden="false" id="951f1b33-dcc4-467a-bdbd-efced24b3980">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="745cb8cf-c465-4163-aeaf-e2050a005580" includeChildSelections="false"/>
      </constraints>
      <selectionEntryGroups>
        <selectionEntryGroup name="Variant Selection" id="db3979e9-3e1d-4803-8b79-eecab23c7d1e" hidden="false">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="self" shared="true" id="a8dba8a2-e5c4-4653-9367-cae3fa91c6b8" includeChildSelections="false"/>
            <constraint type="max" value="1" field="selections" scope="self" shared="true" id="ed317516-64ba-413c-8709-a63444764b14" includeChildSelections="false"/>
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Procession of the Blessed Flock" hidden="false" id="1e805232-b08b-4b7f-b617-969e6bb9cf0f">
              <profiles>
                <profile name="Shepherds and Lambs" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="bb404e97-a7cc-4627-a924-acac3c817773"><characteristics><characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">A Blessed Flock may include 1-3 Lazarist Castigators and 1-6 Lazarist Communicants. One Lazarist Castigator must be taken for every 2 Lazarist Communicants or part thereof. Lazarist Communicants do not have the ELITE Keyword and their cost is unchanged.</characteristic></characteristics></profile>
                <profile name="Guidance" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="33a0cdad-29bd-46aa-b40e-e9382f0bcb96"><characteristics><characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">If a friendly Lazarist Communicant Activates while not within 6&quot; of a friendly Lazarist Castigator, all Success Rolls they make during that Activation are Risky. This has no additional effect if the rolls are already Risky.</characteristic></characteristics></profile>
                <profile name="Dishevelled Procession" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="ce02c1d8-9d47-453e-bdd0-89464d9d6f33"><characteristics><characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">A Blessed Flock may include 0-2 Stigmatic Nuns and cannot include Anchorite Shrines or Leper-Pilgrims.</characteristic></characteristics></profile>
                <profile name="Flagellant Flock" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="f815f010-77f3-4329-940f-24fcaf1c05b3"><characteristics><characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Ecclesiastic Prisoners have a Ranged Characteristic of -1 DICE at no extra cost. They may purchase Muskets, Blunderbusses, Warcrosses, Flails/Scourges, Ragged Vestments, and Trench Shields from the Procession armoury.</characteristic></characteristics></profile>
                <profile name="Scavenged Armoury" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="371ddb80-dd74-4bbd-b9c8-7fa8cb77bfaf"><characteristics><characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">A Blessed Flock cannot include Automatic Pistols, Semi-Automatic Rifles, Sniper Rifles, Submachine Guns, Incendiary Grenades, or Reinforced Armour.</characteristic></characteristics></profile>
              </profiles>
              <modifiers>
                <modifier type="add" value="Blessed Flock warbands cannot include Automatic Pistols" field="error"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="f294-f3b2-5577-bc17" shared="true" includeChildSelections="true"/></conditions></modifier>
                <modifier type="add" value="Blessed Flock warbands cannot include Semi-Automatic Rifles" field="error"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="4111-f437-2e81-899f" shared="true" includeChildSelections="true"/></conditions></modifier>
                <modifier type="add" value="Blessed Flock warbands cannot include Sniper Rifles" field="error"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="808a-f077-4fec-ef82" shared="true" includeChildSelections="true"/></conditions></modifier>
                <modifier type="add" value="Blessed Flock warbands cannot include Submachine Guns" field="error"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="0754-f896-3f97-65c7" shared="true" includeChildSelections="true"/></conditions></modifier>
                <modifier type="add" value="Blessed Flock warbands cannot include Incendiary Grenades" field="error"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="8adc-0183-0ef9-12a4" shared="true" includeChildSelections="true"/></conditions></modifier>
                <modifier type="add" value="Blessed Flock warbands cannot include Reinforced Armour" field="error"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="a535-4fb6-c587-691a" shared="true" includeChildSelections="true"/></conditions></modifier>
                <modifier type="add" value="Blessed Flock warbands cannot include Leper-Pilgrims" field="error"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="6e13-b490-6574-443c" shared="true" includeChildSelections="true"/></conditions></modifier>
                <modifier type="add" value="Blessed Flock warbands cannot include Anchorite Shrines" field="error"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="4ed5-3209-4bf7-4b02" shared="true" includeChildSelections="true"/></conditions></modifier>
              </modifiers>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="The Knights of Saint Lazarus" hidden="false" id="a1e1-b2e2-c3e3-d4e4">
              <profiles>
                <profile name="Sacred Code" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="a1e1-b2e2-c3e3-d4e5"><characteristics><characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">A Knights of Saint Lazarus Warband must include 1-6 Stigmatic Nuns. It cannot include Lazarist Communicants or Lazarist Castigators, and its models cannot voluntarily take a Retreat ACTION.</characteristic></characteristics></profile>
                <profile name="Knightly Order" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="a1e1-b2e2-c3e3-d4e6"><characteristics><characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">A Knights of Saint Lazarus Warband must include 1-3 Leper-Knights. Leper-Knights use the Lazarist Castigator Warband entry, but must wear Armour, have a Melee Characteristic of +2 DICE, and replace Whip of God with Knightly Code.</characteristic></characteristics></profile>
                <profile name="Blessed Armoury" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="a1e1-b2e2-c3e3-d4e7"><characteristics><characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Automatic Pistols cost 15 ducats and Great Swords cost 7 Glory. Models in this Warband cannot have Ranged Weapons that cost more than 15 ducats or any Glory.</characteristic></characteristics></profile>
                <profile name="Followers of Saint Lazarus" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="a1e1-b2e2-c3e3-d4e8"><characteristics><characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">A Knights of Saint Lazarus Warband may choose a Temporal Lord as its Patron in addition to the standard Patron options.</characteristic></characteristics></profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <categoryLinks><categoryLink targetId="705b-e23f-e9c2-58ab" id="cffcd6d8-4c59-402e-920a-b8176972c467" primary="true" name="Configuration"/></categoryLinks>
    </selectionEntry>
    <selectionEntry type="model" import="true" name="Lazarist Castigator" hidden="true" id="c1a5-7d3e-4b90-1f62">
      <comment>Procession of the Sacred Affliction (replaces the base Castigator when the Procession variant is selected)</comment>
      <profiles>
        <profile name="Lazarist Castigator" typeId="b3af-94f9-2e35-d1c5" typeName="Unit" hidden="false" id="c1a5-7d3e-4b90-2001">
          <characteristics>
            <characteristic name="Movement" typeId="b725-e0a4-16ae-8df2">6&quot;/Infantry</characteristic>
            <characteristic name="Ranged" typeId="1a4f-d2cd-c405-6200">+1 DICE</characteristic>
            <characteristic name="Melee" typeId="12e8-ff8c-c933-9eb5">+1 DICE</characteristic>
            <characteristic name="Armour" typeId="5de9-d70e-9021-6f71">0</characteristic>
            <characteristic name="Base" typeId="73ae-cc17-596e-0481">32mm</characteristic>
          </characteristics>
          <modifiers>
            <modifier type="set" value="Leper-Knight" field="name"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="a1e1-b2e2-c3e3-d4e4" shared="true" includeChildSelections="true"/></conditions></modifier>
            <modifier type="set" value="+2 DICE" field="12e8-ff8c-c933-9eb5"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="a1e1-b2e2-c3e3-d4e4" shared="true" includeChildSelections="true"/></conditions></modifier>
          </modifiers>
          <modifierGroups>
            <modifierGroup type="and">
              <modifiers>
                <modifier type="decrement" value="1" field="5de9-d70e-9021-6f71">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="self" childId="2bc5-1430-4c95-efe0" shared="true" includeChildSelections="true"/>
                  </conditions>
                </modifier>
                <modifier type="set" value="-1" field="5de9-d70e-9021-6f71">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="self" childId="5d80-7b84-5e97-9b76" shared="true" includeChildSelections="true"/>
                        <condition type="atLeast" value="1" field="selections" scope="self" childId="ea8a-62b2-605f-6aa6" shared="true" includeChildSelections="true"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
                <modifier type="set" value="-2" field="5de9-d70e-9021-6f71">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="self" childId="0e4c-78a2-26bf-6e0e" shared="true" includeChildSelections="true"/>
                      </conditions>
                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <comment>armour adjustments</comment>
            </modifierGroup>
          </modifierGroups>
        </profile>
        <profile name="Enforced Orthodoxy" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="c1a5-7d3e-4b90-2003">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Enforced Orthodoxy ACTION: A Lazarist Castigator can take an Enforced Orthodoxy ACTION. If they do so, take a Risky Success Roll for the model and add +1 DICE to the roll. If the roll is a Failure, the Lazarist Castigator&apos;s Activation ends immediately. If the roll is a Success or Critical Success, all friendly models that are within 8&quot; of a Lazarist Castigator that are Down immediately stand back up at no cost to their movement.</characteristic>
          </characteristics>
        </profile>
        <profile name="Whip of God" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="c1a5-7d3e-4b90-2002">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Whip of God: When a Lazarist Castigator makes a Melee Attack they can target a friendly model that is within 1&quot; instead of an enemy model, and can add -1 INJURY DICE to the Injury Roll if they do so. Set aside a D6 each time a Lazarist Castigator attacks a friendly model and takes them Out of Action with a Melee Attack. The next time the Lazarist Castigator&apos;s Warband is forced to take a Morale Check, each D6 that was put aside adds +1 DICE to the roll and is then discarded.</characteristic>
          </characteristics>
          <modifiers><modifier type="set" value="true" field="hidden"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="a1e1-b2e2-c3e3-d4e4" shared="true" includeChildSelections="true"/></conditions></modifier></modifiers>
        </profile>
        <profile name="Knightly Code" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="true" id="a1e1-b2e2-c3e3-d4e9">
          <characteristics><characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">When a Leper-Knight makes a Melee Attack that takes an enemy model Out of Action, you can remove 1 BLOOD MARKER from the Leper-Knight or a friendly model within 3&quot; of it. If the enemy model had the ELITE Keyword, you can place 1 BLESSING MARKER beside the Leper-Knight instead of removing a BLOOD MARKER.</characteristic></characteristics>
          <modifiers><modifier type="set" value="false" field="hidden"><conditions><condition type="atLeast" value="1" field="selections" scope="roster" childId="a1e1-b2e2-c3e3-d4e4" shared="true" includeChildSelections="true"/></conditions></modifier></modifiers>
        </profile>
      </profiles>
      <constraints>
        <constraint type="min" value="0" field="selections" scope="roster" shared="true" id="27a41677-613b-4547-8874-f32c9270169d" includeChildSelections="true"/>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="c1a5-7d3e-4b90-2004" includeChildSelections="true"/>
      </constraints>
      <categoryLinks>
        <categoryLink targetId="afb7-d895-f4b4-73f3" id="c1a5-7d3e-4b90-2101" primary="false" name="Pilgrim"/>
        <categoryLink targetId="3de0-192c-3ec2-51be" id="c1a5-7d3e-4b90-2102" primary="true" name="Elite"/>
      </categoryLinks>
      <entryLinks>
