      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Abyssal Armour" hidden="false" id="d24f-2eee-a12e-7420" sortIndex="4">
          <costs>
            <cost name="Ducats" typeId="8d43-33fd-332d-17a6" value="5"/>
