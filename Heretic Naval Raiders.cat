          <profiles>
            <profile name="Leviathan Bell" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="79b2-9498-c398-3623">
              <characteristics>
                <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">You do not have to take a Risky Success Roll for a Drowned Chorister with a Leviathan Bell when they Climb or Jump, nor make an Injury Roll if they Fall.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3242-bb3c-8358-5393" includeChildSelections="false"/>
