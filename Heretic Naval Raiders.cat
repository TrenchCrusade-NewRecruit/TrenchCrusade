          <profiles>
            <profile name="Abyssal Armour" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="0d54-9e9d-9dd0-60ca">
              <characteristics>
                <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">An Abyssal Commando in Abyssal Armour counts any terrain that is partially or fully made of water as Open terrain. When touching such terrain they may use a Fade ACTION and count as in Cover if the terrain&apos;s area is larger than a 32mm base.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="123e-98c1-0174-f546" includeChildSelections="false"/>
          </constraints>
          <modifiers>
            <modifier type="add" value="Abyssal Armour requires Reinforced Armour" field="error">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="model" childId="a535-4fb6-c587-691a" shared="true" includeChildSelections="true"/>
