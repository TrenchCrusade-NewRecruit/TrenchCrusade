        <entryLink import="true" name="Naval Battlekit" hidden="false" id="de44-cdfc-8e12-7c34" type="selectionEntryGroup" targetId="31cb-15a6-6f6b-d677" collapsible="true"/>
      </entryLinks>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Infernal Mines" hidden="false" id="a4f3-8e2c-ae21-3c5b">
          <costs>
            <cost name="Ducats" typeId="8d43-33fd-332d-17a6" value="10"/>
          </costs>
          <profiles>
            <profile name="Infernal Mine" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="5b17-ae6e-df1d-69d2">
              <characteristics>
                <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">After rolling for scatter, an Infernal Bomb can be left in place to be detonated later by the close proximity of an enemy model or at the option of the player controlling the Sea Hag. Leave a marker where the bomb landed. If an enemy model finishes a move within 3&quot; of it, you can interrupt its Activation and detonate the mine. If an unexploded mine is on the battlefield at the beginning of the Sea Hag&apos;s Activation it can be detonated with a Detonate ACTION. Resolve it as an Infernal Bomb. A Sea Hag may have only 1 Infernal Mine marker in play at any one time.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a708-0894-982a-761d" includeChildSelections="false"/>
          </constraints>
        </selectionEntry>
      </selectionEntries>
      <modifiers>
        <modifier type="set" value="Sea Hag" field="name"/>
        <modifier type="set" value="Sea Hag" field="name" affects="profiles.Unit"/>
      </modifiers>
    </entryLink>
