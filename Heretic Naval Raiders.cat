<catalogue library="false" id="6497-8a39-4f5c-9873" name="Heretic Naval Raiders" gameSystemId="sys-4f3d-c5c9-7df1-ad01" gameSystemRevision="1" revision="1" battleScribeVersion="2.03" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <selectionEntries>
    <selectionEntry type="upgrade" import="true" name="Heretic Naval Raiders Rules" hidden="false" id="4d05-603e-4b5a-aed4">
      <profiles>
        <profile name="Fast as Lightning" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="9d93-8642-ca3e-ad48">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Add +1 DICE to the Risky Success Roll for models from a Heretic Naval Raiders Warband that are taking a Dash ACTION.</characteristic>
          </characteristics>
        </profile>
        <profile name="Unseen Advance" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="eeb4-b3ae-c7eb-5bf5">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Up to 3 models without the ELITE Keyword in a Heretic Naval Raiders Warband can be given the INFILTRATOR Keyword at a cost of 10 ducats each.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mercenaries" typeId="058c-866b-6487-ccc4" typeName="Ability" hidden="false" id="486f-5f63-8579-ac87">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Heretic Naval Raiders Warbands can use any Fallen Mercenaries that can be taken by HERETIC Warbands.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint type="min" value="1" field="selections" scope="roster" shared="true" id="ba69-1240-b9ed-65ab" includeChildSelections="true" includeChildForces="true"/>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="7d4f-ec36-2951-e29f" includeChildSelections="true" includeChildForces="true"/>
